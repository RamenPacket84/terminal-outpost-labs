{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/terminal-outpost-labs.txt",
    "color": {
      "1": "#5fc9c7",
      "2": "#d2ad67",
      "3": "#8d684d",
      "4": "#718187",
      "5": "#89b982"
    },
    "padding": {
      "top": 0,
      "right": 3,
      "left": 1
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#7A6A2C"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "#7A6A2C"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "#a3850e",
      "text": "echo \"Omarchy\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#a3850e"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#a3850e"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#a3850e"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#a3850e"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#a3850e"
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#a3850e"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#6E6A58",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#6E6A58"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
